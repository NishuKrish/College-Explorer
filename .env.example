# Shared
APP_ENV=development

# PostgreSQL
POSTGRES_DB=college_exploration
POSTGRES_USER=college
POSTGRES_PASSWORD=college
# Host port for the Docker Postgres. Change this if a native PostgreSQL service
# already owns 5432 on your machine; the container port stays 5432 either way.
POSTGRES_PORT=5432
# 127.0.0.1 rather than localhost: on Windows, localhost resolves to IPv6 through Docker's port
# proxy, which measured ~10x slower for semantic search's larger statements.
DATABASE_URL=postgresql+psycopg://college:college@127.0.0.1:5432/college_exploration

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_ENABLED=true
CACHE_KEY_VERSION=v1
CACHE_SEARCH_TTL_SECONDS=300
CACHE_PROFILE_TTL_SECONDS=3600
CACHE_RANKING_TTL_SECONDS=300

# Security (V3.5)
# Fixed-window per-client limit on the compute-heavy POST endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Required to serve GET /analytics/summary when APP_ENV is not development.
# Unset in a deployed environment means the endpoint returns 503 rather than serving
# product analytics publicly. Operators paste this value into the /analytics page.
ANALYTICS_API_TOKEN=

# External services
# Free key from https://api.data.gov/signup, used by scripts/fetch_scorecard.py.
# Keep the real value in .env (gitignored), never here.
SCORECARD_API_KEY=
# OPENAI_API_KEY=

# Optional AI counselor: Groq free-tier hosted open-weight GPT-OSS.
COUNSELOR_ENABLED=false
GROQ_API_KEY=
COUNSELOR_MODEL=openai/gpt-oss-120b
COUNSELOR_DAILY_LIMIT=100
